<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/rvPlaylistSongs"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingTop="75dp"
		android:paddingBottom="75dp"
		android:clipToPadding="false"
		android:overScrollMode="never"
		android:paddingHorizontal="8dp"
		app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
		tools:listitem="@layout/dome" />
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardBack"
		android:layout_width="46dp"
		android:layout_height="46dp"
		android:layout_marginTop="16dp"
		app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
		android:layout_marginStart="16dp"
		app:cardCornerRadius="23dp"
		app:cardElevation="0dp"
		app:strokeWidth="0dp"
		app:rippleColor="@android:color/transparent"
		android:layout_alignParentTop="true"
		android:layout_alignParentStart="true">
		<ImageView
			android:id="@+id/btnBack"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="11dp"
			android:src="@drawable/icon_arrow"
			android:scaleType="fitCenter"
			app:tint="?attr/colorOnSurface" />
	</com.google.android.material.card.MaterialCardView>
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardPlaylistTitleContainer"
		android:layout_width="wrap_content"
		android:layout_height="46dp"
		android:layout_marginTop="16dp"
		app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
		android:layout_marginStart="12dp"
		android:layout_marginEnd="12dp"
		app:cardCornerRadius="23dp"
		app:cardElevation="0dp"
		app:strokeWidth="0dp"
		app:rippleColor="@android:color/transparent"
		android:layout_toStartOf="@id/btnDeletePlaylist"
		android:layout_alignParentTop="true"
		android:layout_toEndOf="@id/cardBack">
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:gravity="center_vertical"
			android:orientation="vertical"
			android:paddingHorizontal="16dp">
			<TextView
				android:id="@+id/txtPlaylistTitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Playlist Name"
				android:textSize="15sp"
				android:textStyle="bold"
				android:singleLine="true" />
			<TextView
				android:id="@+id/txtTrackCount"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="0 Tracks"
				android:textSize="11sp" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/btnDeletePlaylist"
		android:layout_width="wrap_content"
		android:layout_height="46dp"
		android:layout_marginTop="16dp"
		app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
		android:layout_marginEnd="16dp"
		app:cardCornerRadius="23dp"
		app:cardElevation="0dp"
		app:strokeWidth="0dp"
		app:rippleColor="@android:color/transparent"
		android:layout_alignParentTop="true"
		android:layout_alignParentEnd="true">
		<LinearLayout
			android:id="@+id/linear6"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="4dp"
			android:paddingEnd="4dp">
			<ImageView
				android:id="@+id/btn_remove_playlist"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:padding="4dp"
				android:background="@android:color/transparent"
				android:src="@drawable/icon_remove_circle"
				android:scaleType="fitCenter"
				android:layout_marginStart="4dp"
				android:layout_marginEnd="4dp"
				app:tint="?attr/colorError"
				android:visibility="gone"
				android:focusable="false" />
			<com.google.android.material.checkbox.MaterialCheckBox
				android:id="@+id/checkboxPlaylist"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:background="@android:color/transparent"
				android:layout_marginStart="4dp"
				android:layout_marginEnd="4dp"
				android:visibility="gone"
				android:focusable="false" />
			<ImageView
				android:id="@+id/imageview_delete"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:padding="4dp"
				android:src="@drawable/icon_delete"
				android:scaleType="fitCenter"
				app:tint="?attr/colorOnSurface"
				android:layout_marginStart="4dp"
				android:layout_marginEnd="4dp"
				android:focusable="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/btnAddSongs"
		android:layout_width="72dp"
		android:layout_height="48dp"
		android:layout_marginBottom="16dp"
		app:cardBackgroundColor="?attr/colorPrimaryContainer"
		app:cardCornerRadius="24dp"
		app:cardElevation="4dp"
		app:strokeWidth="0dp"
		app:rippleColor="@android:color/transparent"
		android:layout_alignParentBottom="true"
		android:layout_centerHorizontal="true">
		<ImageView
			android:id="@+id/imageview2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="4dp"
			android:src="@drawable/ic_add"
			android:scaleType="centerInside"
			app:tint="?attr/colorOnPrimaryContainer" />
	</com.google.android.material.card.MaterialCardView>
</RelativeLayout>
