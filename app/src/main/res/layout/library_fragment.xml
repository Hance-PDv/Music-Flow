<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	android:orientation="vertical">
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">
		<LinearLayout
			android:id="@+id/linear9"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="5dp"
			android:paddingRight="5dp"
			android:orientation="vertical">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="5dp"
				app:cardBackgroundColor="?attr/colorPrimaryContainer"
				app:cardCornerRadius="24dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeWidth="0dp"
				app:cardPreventCornerOverlap="false">
				<LinearLayout
					android:id="@+id/linear10"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<RelativeLayout
						android:id="@+id/relativelayout2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content">
						<LinearLayout
							android:id="@+id/linear48"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_alignParentStart="true">
							<TextView
								android:id="@+id/textview7"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="YOUR LIBRARY"
								android:textSize="10sp"
								android:textStyle="bold"
								android:letterSpacing="0.08"
								android:alpha="0.7" />
							<TextView
								android:id="@+id/textview8"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="Listening stats"
								android:textSize="24sp"
								android:textStyle="bold" />
						</LinearLayout>
						<ImageView
							android:id="@+id/imageview2"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/icon_arrow"
							android:scaleType="center"
							android:rotation="180"
							app:tint="?attr/colorOnPrimaryContainer"
							android:layout_alignParentEnd="true"
							android:layout_centerVertical="true" />
					</RelativeLayout>
					<View
						android:id="@+id/view73"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="14dp"
						android:layout_marginBottom="12dp"
						android:background="?attr/colorOnPrimaryContainer"
						android:alpha="0.2" />
					<LinearLayout
						android:id="@+id/linear11"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear12"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/textview9"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="PLAYS"
								android:textSize="9sp"
								android:textStyle="bold"
								android:letterSpacing="0.05"
								android:alpha="0.7" />
							<TextView
								android:id="@+id/txtStatPlays"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="0"
								android:textSize="16sp"
								android:textStyle="bold" />
						</LinearLayout>
						<View
							android:id="@+id/view74"
							android:layout_width="1dp"
							android:layout_height="match_parent"
							android:layout_marginLeft="8dp"
							android:layout_marginRight="8dp"
							android:background="?attr/colorOnPrimaryContainer"
							android:alpha="0.2" />
						<LinearLayout
							android:id="@+id/linear13"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/textview10"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="LISTENED"
								android:textSize="9sp"
								android:textStyle="bold"
								android:letterSpacing="0.05"
								android:alpha="0.7" />
							<TextView
								android:id="@+id/txtStatListened"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="0m"
								android:textSize="16sp"
								android:textStyle="bold" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear14"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear15"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/textview11"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="EXPLORED"
								android:textSize="9sp"
								android:textStyle="bold"
								android:letterSpacing="0.05"
								android:alpha="0.7" />
							<TextView
								android:id="@+id/txtStatExplored"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="0"
								android:textSize="16sp"
								android:textStyle="bold" />
						</LinearLayout>
						<View
							android:id="@+id/view75"
							android:layout_width="1dp"
							android:layout_height="match_parent"
							android:layout_marginLeft="8dp"
							android:layout_marginRight="8dp"
							android:background="?attr/colorOnPrimaryContainer"
							android:alpha="0.2" />
						<LinearLayout
							android:id="@+id/linear16"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/textview12"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="TOP TRACK"
								android:textSize="9sp"
								android:textStyle="bold"
								android:letterSpacing="0.05"
								android:alpha="0.7" />
							<TextView
								android:id="@+id/txtStatTopTrack"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="Unknown"
								android:textSize="14sp"
								android:textStyle="bold"
								android:ellipsize="end"
								android:maxLines="1" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardPlaylists"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_margin="5dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				app:cardCornerRadius="24dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeColor="?attr/colorOutlineVariant"
				app:strokeWidth="1dp"
				app:cardPreventCornerOverlap="false">
				<LinearLayout
					android:id="@+id/linearPlaylistsContainer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<RelativeLayout
						android:id="@+id/layoutPlaylistHeader"
						android:layout_width="match_parent"
						android:layout_height="wrap_content">
						<LinearLayout
							android:id="@+id/linear3"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_alignParentStart="true"
							android:layout_centerVertical="true">
							<TextView
								android:id="@+id/txtPlaylistSubtitle"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="COLLECTIONS"
								android:textSize="10sp"
								android:textStyle="bold"
								android:letterSpacing="0.08"
								android:alpha="0.7" />
							<LinearLayout
								android:id="@+id/linear8"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<ImageView
									android:id="@+id/imgPlaylistHeaderIcon"
									android:layout_width="22dp"
									android:layout_height="22dp"
									android:src="@drawable/icon_playlist"
									android:scaleType="fitCenter"
									android:layout_marginEnd="8dp"
									app:tint="?attr/colorOnSurface" />
								<TextView
									android:id="@+id/txtPlaylistTitle"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Playlists"
									android:textSize="22sp"
									android:textStyle="bold" />
							</LinearLayout>
						</LinearLayout>
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/btnCreatePlaylist"
							android:layout_width="38dp"
							android:layout_height="38dp"
							app:cardBackgroundColor="?attr/colorSurfaceVariant"
							android:focusable="true"
							app:cardCornerRadius="19dp"
							app:cardElevation="0dp"
							app:cardMaxElevation="0dp"
							app:strokeColor="?attr/colorOutlineVariant"
							app:strokeWidth="1dp"
							app:cardPreventCornerOverlap="false"
							android:layout_alignParentEnd="true"
							android:layout_centerVertical="true">
							<ImageView
								android:id="@+id/imageview3"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:src="@drawable/ic_add"
								android:scaleType="centerCrop"
								app:tint="?attr/colorPrimary" />
						</com.google.android.material.card.MaterialCardView>
					</RelativeLayout>
					<View
						android:id="@+id/view4"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="12dp"
						android:layout_marginBottom="12dp"
						android:background="?attr/colorOutlineVariant" />
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/rvPlaylists"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:nestedScrollingEnabled="false"
						app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
						tools:listitem="@layout/listplay" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
