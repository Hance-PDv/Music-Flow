<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="#090A0F"
	android:gravity="center">
	<LinearLayout
		android:id="@+id/linear34"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:layout_weight="1"
		android:paddingHorizontal="24dp">
		<RelativeLayout
			android:id="@+id/frame_layout35"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_horizontal|center_vertical">
			<TextView
				android:id="@+id/txt_m"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:text="M"
				android:textSize="80sp"
				android:textStyle="bold"
				android:textColor="#38BDF8"
				android:includeFontPadding="false"
				android:letterSpacing="0.05"
				android:layout_centerInParent="true" />
			<LinearLayout
				android:id="@+id/full_name_container"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:alpha="0"
				android:layout_centerInParent="true">
				<TextView
					android:id="@+id/textview8"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="M"
					android:textSize="58sp"
					android:textStyle="bold"
					android:textColor="#38BDF8"
					android:includeFontPadding="false"
					android:letterSpacing="0.05" />
				<TextView
					android:id="@+id/txt_flow"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Flow"
					android:textSize="58sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:includeFontPadding="false"
					android:letterSpacing="0.05" />
			</LinearLayout>
		</RelativeLayout>
		<TextView
			android:id="@+id/txt_subtitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="24dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="P L A Y   Y O U R   W A Y"
			android:textSize="11sp"
			android:textColor="#4B5563"
			android:letterSpacing="0.25" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/bottom_container"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="40dp"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical">
		<com.airbnb.lottie.LottieAnimationView
			android:id="@+id/lottie_loading"
			android:layout_width="64dp"
			android:layout_height="64dp"
			app:lottie_fileName="loadingV4.json"
			app:lottie_autoPlay="true"
			app:lottie_loop="true" />
		<LinearLayout
			android:id="@+id/linear36"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/txt_version"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="v3.0"
				android:textSize="11sp"
				android:textStyle="bold"
				android:textColor="#3B82F6" />
			<TextView
				android:id="@+id/textview9"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="  •  "
				android:textSize="10sp"
				android:textColor="#374151" />
			<TextView
				android:id="@+id/textview1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="\\@x_hance_x"
				android:textSize="11sp"
				android:textColor="#4B5563" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
