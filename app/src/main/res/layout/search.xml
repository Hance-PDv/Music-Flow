<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/rootSearchLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear13"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/rvSearchResults"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:paddingHorizontal="12dp"
			android:overScrollMode="never"
			app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
			tools:listitem="@layout/music" />
		<LinearLayout
			android:id="@+id/linear14"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardSearchBack"
				android:layout_width="50dp"
				android:layout_height="50dp"
				app:cardBackgroundColor="?attr/colorSurfaceVariant"
				app:cardCornerRadius="25dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeColor="?attr/colorOutlineVariant"
				app:strokeWidth="1dp"
				app:rippleColor="@android:color/transparent">
				<ImageView
					android:id="@+id/btnSearchBack"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="14dp"
					android:src="@drawable/icon_arrow"
					android:scaleType="centerInside"
					app:tint="?attr/colorOnSurface" />
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardSearchInput"
				android:layout_width="0dp"
				android:layout_height="50dp"
				app:cardBackgroundColor="?attr/colorSurfaceVariant"
				android:layout_weight="1"
				android:layout_marginStart="12dp"
				app:cardCornerRadius="25dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeColor="?attr/colorOutlineVariant"
				app:strokeWidth="1dp"
				app:rippleColor="@android:color/transparent">
				<LinearLayout
					android:id="@+id/linearSearchContainer"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingHorizontal="16dp">
					<ImageView
						android:id="@+id/imgSearchIcon"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/icon_search"
						android:scaleType="centerInside"
						app:tint="?attr/colorOnSurfaceVariant" />
					<EditText
						android:id="@+id/etSearchQuery"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:background="@android:color/transparent"
						android:textSize="15sp"
						android:hint="Search tracks, artists..."
						android:singleLine="true"
						android:imeOptions="actionSearch"
						android:layout_weight="1"
						android:paddingStart="10dp"
						android:paddingEnd="10dp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</LinearLayout>
</RelativeLayout>
