<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    app:strokeWidth="0dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Drag Handle Indicator -->
        <View
            android:id="@+id/dialogDragHandle"
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- Header: Title بتباين عالي -->
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Songs to Add"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Main Content: RecyclerView -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAddSongs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Empty State Text -->
            <TextView
                android:id="@+id/txtEmptyDialog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="All songs are already in this playlist"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Bottom Action Buttons (أزرار مخصصة بهوية مستقلة ومظهر نظيف) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <!-- زر إلغاء (هوية ثانوية SurfaceContainerHighest) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDialog"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Cancel"
                android:textColor="?attr/colorOnSurface"
                android:textAllCaps="false"
                app:cornerRadius="24dp"
                app:backgroundTint="?attr/colorSurfaceContainerHighest"
                android:layout_marginEnd="8dp" />

            <!-- زر تم/تأكيد (هوية أساسية بارزة PrimaryContainer) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneDialog"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Done"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textAllCaps="false"
                app:backgroundTint="?attr/colorPrimaryContainer"
                app:cornerRadius="24dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
