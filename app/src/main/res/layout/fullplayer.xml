<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/mTopLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="16dp"
		android:paddingVertical="12dp">
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview16"
			android:layout_width="46dp"
			android:layout_height="46dp"
			app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
			app:cardCornerRadius="23dp"
			app:cardElevation="0dp"
			app:cardMaxElevation="0dp"
			app:strokeWidth="0dp"
			app:rippleColor="@android:color/transparent">
			<ImageView
				android:id="@+id/img_back"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="11dp"
				android:src="@drawable/icon_arrow"
				android:scaleType="fitCenter"
				app:tint="?attr/colorOnSurface" />
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview4"
			android:layout_width="0dp"
			android:layout_height="46dp"
			app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
			android:layout_weight="1"
			android:layout_marginHorizontal="10dp"
			app:cardCornerRadius="23dp"
			app:cardElevation="0dp"
			app:cardMaxElevation="0dp"
			app:strokeWidth="0dp"
			app:rippleColor="@android:color/transparent">
			<LinearLayout
				android:id="@+id/linear53"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:paddingHorizontal="16dp">
				<TextView
					android:id="@+id/titlef"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:text="Music title"
					android:textSize="13sp"
					android:textStyle="bold"
					android:singleLine="true"
					android:ellipsize="marquee"
					android:focusable="true"
					android:focusableInTouchMode="true"
					android:marqueeRepeatLimit="marquee_forever"
					android:scrollHorizontally="true"
					android:maxLines="1" />
				<TextView
					android:id="@+id/artf"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:text="Artist name"
					android:textSize="10sp"
					android:textStyle="bold"
					android:singleLine="true"
					android:ellipsize="end"
					android:maxLines="1" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview55"
			android:layout_width="46dp"
			android:layout_height="46dp"
			app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
			app:cardCornerRadius="23dp"
			app:cardElevation="0dp"
			app:cardMaxElevation="0dp"
			app:strokeWidth="0dp"
			app:rippleColor="@android:color/transparent">
			<ImageView
				android:id="@+id/sleep"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="11dp"
				android:src="@drawable/icon_night1"
				android:scaleType="fitCenter"
				app:tint="?attr/colorOnSurface" />
		</com.google.android.material.card.MaterialCardView>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/timer_sleep"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal"
		android:layout_marginTop="-4dp"
		android:layout_gravity="end"
		android:layout_marginEnd="20dp">
		<TextView
			android:id="@+id/text1"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="11sp"
			android:textStyle="bold"
			android:maxLines="1" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/PlayerLayout"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:paddingBottom="16dp"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:layout_weight="1"
		android:paddingHorizontal="16dp">
		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/constraint_layout17"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="4.2"
			android:paddingVertical="8dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/mAlbumCardView"
				android:layout_width="0dp"
				android:layout_height="0dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainer"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:cardCornerRadius="24dp"
				app:strokeWidth="0dp"
				app:rippleColor="@android:color/transparent"
				app:layout_constraintDimensionRatio="1:1"
				app:layout_constraintWidth_max="320dp"
				app:layout_constraintTop_toTopOf="parent"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent">
				<ImageView
					android:id="@+id/mAlbumImageView"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:src="@drawable/default_music_image"
					android:scaleType="centerCrop" />
			</com.google.android.material.card.MaterialCardView>
		</androidx.constraintlayout.widget.ConstraintLayout>
		<Space
			android:id="@+id/space15"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="0.2" />
		<LinearLayout
			android:id="@+id/linear16"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="12dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview94"
				android:layout_width="46dp"
				android:layout_height="42dp"
				app:cardBackgroundColor="?attr/colorSecondaryContainer"
				android:layout_marginHorizontal="8dp"
				app:cardCornerRadius="21dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeWidth="0dp"
				app:rippleColor="@android:color/transparent">
				<ImageView
					android:id="@+id/repeat"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="9dp"
					android:src="@drawable/icon_repeat"
					android:scaleType="fitCenter"
					app:tint="?attr/colorOnSecondaryContainer" />
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview94_fav"
				android:layout_width="46dp"
				android:layout_height="42dp"
				app:cardBackgroundColor="?attr/colorSecondaryContainer"
				android:layout_marginHorizontal="8dp"
				app:cardCornerRadius="21dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeWidth="0dp"
				app:rippleColor="@android:color/transparent">
				<ImageView
					android:id="@+id/fave"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="9dp"
					android:src="@drawable/icon_fav"
					android:scaleType="fitCenter"
					app:tint="?attr/colorOnSecondaryContainer" />
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview93"
				android:layout_width="46dp"
				android:layout_height="42dp"
				app:cardBackgroundColor="?attr/colorSecondaryContainer"
				android:layout_marginHorizontal="8dp"
				app:cardCornerRadius="21dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeWidth="0dp"
				app:rippleColor="@android:color/transparent">
				<ImageView
					android:id="@+id/btn_lyrics"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="9dp"
					android:src="@drawable/icon_lyric"
					android:scaleType="fitCenter"
					app:tint="?attr/colorOnSecondaryContainer" />
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/mMusicProgressLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="12dp"
			android:orientation="vertical">
			<SeekBar
				android:id="@+id/SeekBar1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@null"
				android:maxHeight="16dp"
				android:minHeight="16dp"
				android:paddingStart="0dp"
				android:paddingEnd="0dp"
				android:progressDrawable="@drawable/custom_seekbar"
				android:thumb="@drawable/custom_thumb"
				android:thumbOffset="0dp"
				android:splitTrack="false" />
			<LinearLayout
				android:id="@+id/linear54"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/pros"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="0:00"
					android:textSize="11sp"
					android:textStyle="bold" />
				<LinearLayout
					android:id="@+id/linear55"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/time"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="0:00"
					android:textSize="11sp"
					android:textStyle="bold" />
			</LinearLayout>
		</LinearLayout>
		<Space
			android:id="@+id/space17"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="0.2" />
		<LinearLayout
			android:id="@+id/mMediaPlayerControlButtonsLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview96"
				android:layout_width="48dp"
				android:layout_height="48dp"
				app:cardBackgroundColor="?attr/colorTertiaryContainer"
				android:layout_marginEnd="20dp"
				app:cardCornerRadius="24dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeWidth="0dp"
				app:rippleColor="@android:color/transparent">
				<ImageView
					android:id="@+id/back"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="10dp"
					android:src="@drawable/icon_previous"
					android:scaleType="fitCenter"
					app:tint="?attr/colorOnTertiaryContainer" />
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview97"
				android:layout_width="64dp"
				android:layout_height="64dp"
				app:cardBackgroundColor="?attr/colorPrimaryContainer"
				app:cardCornerRadius="32dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeWidth="0dp"
				app:rippleColor="@android:color/transparent">
				<ImageView
					android:id="@+id/play"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="12dp"
					android:src="@drawable/icon_play"
					android:scaleType="fitCenter"
					app:tint="?attr/colorOnPrimaryContainer" />
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview98"
				android:layout_width="48dp"
				android:layout_height="48dp"
				app:cardBackgroundColor="?attr/colorTertiaryContainer"
				android:layout_marginStart="20dp"
				app:cardCornerRadius="24dp"
				app:cardElevation="0dp"
				app:cardMaxElevation="0dp"
				app:strokeWidth="0dp"
				app:rippleColor="@android:color/transparent">
				<ImageView
					android:id="@+id/next"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="10dp"
					android:src="@drawable/icon_next"
					android:scaleType="fitCenter"
					app:tint="?attr/colorOnTertiaryContainer" />
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
		<Space
			android:id="@+id/space18"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="0.3" />
	</LinearLayout>
	<com.airbnb.lottie.LottieAnimationView
		android:id="@+id/dummy_lottie"
		android:layout_width="1dp"
		android:layout_height="1dp"
		android:visibility="gone"
		app:lottie_autoPlay="false"
		app:lottie_loop="false" />
</LinearLayout>
